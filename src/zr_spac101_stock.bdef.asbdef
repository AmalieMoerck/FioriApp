managed implementation in class zbp_r_spac101_stock unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC101_STOCK alias STOCK
persistent table zspac101_stock
draft table zspac101_stock_d
lock master total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt

{
  create;
  update;
  delete;


  validation validateProductId on save { create; field ProductId;}
  validation validateAmount on save { create; update; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare{validation validateProductId;}

  field ( readonly : update ) WarehouseId, ProductId;


  field ( readonly )
                     ProductName,
                     ProductDescription,
                     ProductPrice,
                     WarehouseName,
                     WarehouseAdress,
                     WarehouseCity,
                     WarehousePostcode,
                     CreatedBy,
                     CreatedAt,
                     LastChangedAt,
                     LocalLastChangedAt;


  mapping for zspac101_stock
  {
    WarehouseId = warehouse_id;
    ProductId   = product_id;
    Amount      = amount;
    CreatedBy   = local_created_by;
    CreatedAt = local_created_at;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }

}