managed implementation in class zbp_r_spac101_wrhouse unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC101_WRHOUSE alias Warehouse
persistent table zspac101_wrhouse
draft table zspac101_ware_d
lock master total etag LastChangedAt
authorization master ( global, instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  field ( readonly : update ) WarehouseId, WarehouseName, WarehouseCity, WarehouseAdress, WarehousePostcode;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedAt, LocalLastChangedAt;

  mapping for zspac101_wrhouse
  {
    WarehouseId          = warehouse_id;
    WarehouseName        = warehouse_name;

    WarehouseAdress = Warehouse_adress;
    WarehouseCity = Warehouse_city;
    WarehousePostcode = Warehouse_Postcode;
    CreatedBy          = local_created_by;
    CreatedAt          = local_created_at;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}